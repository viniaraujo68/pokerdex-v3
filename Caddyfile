# Replace pokerdex.exemplo.com with your real domain.
# Caddy fetches + renews TLS certs automatically.
pokerdex.exemplo.com {
	encode gzip

	# API → FastAPI
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else → SvelteKit (adapter-node)
	handle {
		reverse_proxy frontend:3000
	}
}

