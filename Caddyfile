# Domain comes from the DOMAIN env var (set in .env). Caddy fetches + renews
# the TLS certificate automatically for it.
{$DOMAIN} {
	encode gzip

	# API → FastAPI
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else → SvelteKit (adapter-node)
	handle {
		reverse_proxy frontend:3000
	}
}
