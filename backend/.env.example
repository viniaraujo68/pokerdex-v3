# Copy to .env and adjust for your environment.
POKERDEX_DATABASE_URL=sqlite:///./pokerdex.db
POKERDEX_COOKIE_SECURE=false
POKERDEX_COOKIE_SAMESITE=lax
POKERDEX_SESSION_TTL_DAYS=30
POKERDEX_CORS_ORIGINS=http://localhost:5173

# Rate limiting por IP (slowapi). Desligue só em testes/benchmarks.
POKERDEX_RATE_LIMIT_ENABLED=true
POKERDEX_RATE_LIMIT_LOGIN=5/minute
POKERDEX_RATE_LIMIT_REGISTER=3/minute
POKERDEX_RATE_LIMIT_PUBLIC=30/minute
